# --- demo service ---
PORT=4000
MONGO_URL=mongodb://localhost:27017
DB_NAME=demo_service
POOL_SIZE=3
# Healthy payment provider (the built-in fake upstream). payment_timeout deletes this at runtime.
STRIPE_API_URL=http://localhost:4000/fake-upstream/ok
# Keep 30000 so log text matches the simulator wording ("request timeout after 30000ms")
PAYMENT_TIMEOUT_MS=30000
# slow_query tuning: lower these if your machine scans 400k docs very fast
SEED_COUNT=400000
SLOW_QUERY_MS=100
SLOW_P95_MS=150
LOG_FILE=logs/app.log
TRAFFIC_RPS=1

# --- shipper ---
MEMORYOPS_URL=http://localhost:5000
BATCH_MS=1000
BATCH_SIZE=20