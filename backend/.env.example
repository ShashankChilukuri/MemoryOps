PORT=5000
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/memoryops
GROQ_API_KEY=gsk_example_api_key
GROQ_MODEL=openai/gpt-oss-120b

HINDSIGHT_URL=https://api.hindsight.vectorize.io
HINDSIGHT_API_KEY=hsk_example_api_key
HINDSIGHT_BANK=memoryops

# Log Ingestion
INCIDENT_WINDOW_MIN=10
INGEST_MAX_AGE_MIN=60

# Auto Diagnosis
AUTO_DIAGNOSE=false
AUTO_DIAGNOSE_MIN_ERRORS=3

# Email Alerts
ALERT_EMAILS=devops@example.com,oncall@example.com
NOTIFY_MIN_SEVERITY=high
NOTIFY_COOLDOWN_MIN=15
DASHBOARD_URL=http://localhost:5173

# SMTP Configuration (Optional - leaves empty to use jsonTransport and console output)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=alerts@memoryops.local
